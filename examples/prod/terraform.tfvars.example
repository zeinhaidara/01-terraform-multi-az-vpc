# Copy to terraform.tfvars and adjust.
region                  = "us-east-1"
vpc_cidr                = "10.20.0.0/16"
az_count                = 3
nat_strategy            = "auto" # per_az for prod, single for dev and stage
flow_log_retention_days = 365

tags = {
  Owner      = "platform-team"
  CostCenter = "1234"
}
